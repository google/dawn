//* This file is NOT intended to be used as a template on its own. Instead, it
//* should be included by implementing api_structs.cpp files in relevant
//* implementations templates. It assumes that the implementing file includes
//* the corresponding api_structs_autogen.h.

{%- from 'dawn/cpp_macros.tmpl' import as_dawnType with context -%}

//* Renders pointer conversions between C types (WGPU...*), Dawn internal types
//* (DawnType*), and C++ API types (wgpu::...*), including identity overloads.
//* This is the shared base macro used by both default and copy structure conversions.
{%- macro render_pointer_structure_conversions(name) -%}
    {% set CType = as_cType(name) %}
    {% set DawnType = as_dawnType(name) %}
    {% set CppType = "wgpu::" + as_cppType(name) %}
    inline const {{CType}}* ToAPI(const {{DawnType}}* rhs) {
        return reinterpret_cast<const {{CType}}*>(rhs);
    }
    inline {{CType}}* ToAPI({{DawnType}}* rhs) {
        return reinterpret_cast<{{CType}}*>(rhs);
    }
    inline const {{CType}}* ToAPI(const {{CType}}* rhs) {
        return rhs;
    }
    inline {{CType}}* ToAPI({{CType}}* rhs) {
        return rhs;
    }
    inline const {{DawnType}}* FromAPI(const {{CType}}* rhs) {
        return reinterpret_cast<const {{DawnType}}*>(rhs);
    }
    inline {{DawnType}}* FromAPI({{CType}}* rhs) {
        return reinterpret_cast<{{DawnType}}*>(rhs);
    }
    inline const {{DawnType}}* FromAPI(const {{DawnType}}* rhs) {
        return rhs;
    }
    inline {{DawnType}}* FromAPI({{DawnType}}* rhs) {
        return rhs;
    }
    inline const {{CppType}}* ToCppAPI(const {{DawnType}}* rhs) {
        return reinterpret_cast<const {{CppType}}*>(rhs);
    }
    inline {{CppType}}* ToCppAPI({{DawnType}}* rhs) {
        return reinterpret_cast<{{CppType}}*>(rhs);
    }
    inline const {{DawnType}}* FromCppAPI(const {{CppType}}* rhs) {
        return reinterpret_cast<const {{DawnType}}*>(rhs);
    }
    inline {{DawnType}}* FromCppAPI({{CppType}}* rhs) {
        return reinterpret_cast<{{DawnType}}*>(rhs);
    }
{%- endmacro -%}

//* Renders reference conversions for standard (non-copyable / descriptor) structures.
//* This provides lvalue reference conversions (FromAPI(const &) and FromAPI(&)) to allow
//* referencing structure instances across API boundaries without deep copies.
{%- macro render_reference_structure_conversions(name) -%}
    {% set CType = as_cType(name) %}
    {% set DawnType = as_dawnType(name) %}
    inline const {{DawnType}}& FromAPI(const {{CType}}& rhs) {
        return *reinterpret_cast<const {{DawnType}}*>(&rhs);
    }
    inline {{DawnType}}& FromAPI({{CType}}& rhs) {
        return *reinterpret_cast<{{DawnType}}*>(&rhs);
    }
    inline const {{DawnType}}& FromAPI(const {{DawnType}}& rhs) {
        return rhs;
    }
    inline {{DawnType}}& FromAPI({{DawnType}}& rhs) {
        return rhs;
    }
{%- endmacro -%}

//* Renders conversions for trivial copyable structures (e.g. StringView, Future)
//* that are passed and returned by value across API boundaries.
//* This provides by-value ToAPI and FromAPI copy overloads. The reference overloads
//* from render_reference_structure_conversions are omitted to prevent C++ overload
//* ambiguity when passing non-const lvalues by value.
{%- macro render_copy_structure_conversions(name) -%}
    {% set CType = as_cType(name) %}
    {% set DawnType = as_dawnType(name) %}
    inline {{CType}} ToAPI({{DawnType}} rhs) {
        return *reinterpret_cast<const {{CType}}*>(&rhs);
    }
    inline {{CType}} ToAPI({{CType}} rhs) {
        return rhs;
    }
    inline {{DawnType}} FromAPI({{CType}} rhs) {
        return *reinterpret_cast<const {{DawnType}}*>(&rhs);
    }
    inline {{DawnType}} FromAPI({{DawnType}} rhs) {
        return rhs;
    }
{%- endmacro -%}

{% set ChainedStructName = Name("chained struct") %}
{{render_pointer_structure_conversions(ChainedStructName)|indent}}
{{render_reference_structure_conversions(ChainedStructName)|indent}}

{% set CopyStructs = ["string view", "future"] %}
{% for type in by_category["structure"] %}
    {{render_pointer_structure_conversions(type.name)|indent}}
    {% if type.name.get() in CopyStructs %}
        {{render_copy_structure_conversions(type.name)|indent}}
    {% else %}
        {{render_reference_structure_conversions(type.name)|indent}}
    {% endif %}
{% endfor %}

{% for type in by_category["object"] %}
    {% set CType = as_cType(type.name) %}
    {% set DawnType = as_dawnType(type) %}
    inline {{CType}} ToAPI({{DawnType}} rhs) {
        return reinterpret_cast<{{CType}}>(rhs);
    }
    inline const {{CType}}* ToAPI({{DawnType}} const* rhs) {
        return reinterpret_cast<const {{CType}}*>(rhs);
    }
    inline {{CType}}* ToAPI({{DawnType}}* rhs) {
        return reinterpret_cast<{{CType}}*>(rhs);
    }

    inline {{DawnType}} FromAPI({{CType}} rhs) {
        return reinterpret_cast<{{DawnType}}>(rhs);
    }
    inline {{DawnType}} const* FromAPI(const {{CType}}* rhs) {
        return reinterpret_cast<{{DawnType}} const*>(rhs);
    }
    inline {{DawnType}}* FromAPI({{CType}}* rhs) {
        return reinterpret_cast<{{DawnType}}*>(rhs);
    }
{% endfor %}

//* In the C API (webgpu.h), WGPUBool is a typedef for uint32_t rather than a distinct
//* struct or enum. In the C++ API, wgpu::Bool is a wrapper struct around WGPUBool.
//* We intentionally do NOT define `FromAPI(WGPUBool)` or `FromAPI(const WGPUBool*)`
//* here, because in C++ WGPUBool is indistinguishable from uint32_t and defining those
//* overloads would cause non-template overload resolution to match ALL uint32_t
//* parameters (like binding indices, counts, sizes) and erroneously convert them into
//* wgpu::Bool.
//* Instead, we define explicit conversions operating specifically on `wgpu::Bool`,
//* while WGPUBool (uint32_t) is handled via the fundamental fallback templates.
inline WGPUBool ToAPI(wgpu::Bool rhs) {
    return static_cast<WGPUBool>(rhs);
}
inline wgpu::Bool FromAPI(wgpu::Bool rhs) {
    return rhs;
}
inline const WGPUBool* ToAPI(const wgpu::Bool* rhs) {
    return reinterpret_cast<const WGPUBool*>(rhs);
}
inline WGPUBool* ToAPI(wgpu::Bool* rhs) {
    return reinterpret_cast<WGPUBool*>(rhs);
}
inline const wgpu::Bool* FromAPI(const wgpu::Bool* rhs) {
    return rhs;
}
inline wgpu::Bool* FromAPI(wgpu::Bool* rhs) {
    return rhs;
}

