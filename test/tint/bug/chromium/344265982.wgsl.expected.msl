#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  device array<int, 4>* tint_member;
};

void foo(device array<int, 4>* const arg) {
  {
    int i = 0;
    while(true) {
      if ((i < 4)) {
      } else {
        break;
      }
      bool tint_continue = false;
      switch((*arg)[i]) {
        case 1:
        {
          tint_continue = true;
          break;
        }
        default:
        {
          (*arg)[i] = 2;
          break;
        }
      }
      if (tint_continue) {
        {
          i = as_type<int>((as_type<uint>(i) + 1u));
        }
        continue;
      }
      {
        i = as_type<int>((as_type<uint>(i) + 1u));
      }
    }
  }
}

fragment void v(device array<int, 4>* v_1 [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.tint_member=v_1};
  (foo(tint_module_vars.tint_member));
}
