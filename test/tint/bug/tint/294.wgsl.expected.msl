#include <metal_stdlib>
using namespace metal;

struct Light {
  float3 position;
  float3 colour;
};

struct Light_packed_vec3 {
  /* 0x0000 */ packed_float3 position;
  /* 0x000c */ array<int8_t, 4> tint_pad;
  /* 0x0010 */ packed_float3 colour;
  /* 0x001c */ array<int8_t, 4> tint_pad_1;
};

struct Lights_packed_vec3 {
  /* 0x0000 */ array<Light_packed_vec3, 1> light;
};

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad_2;
  /* 0x0800 */ array<uint, 1> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  const device Lights_packed_vec3* lights;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

Light tint_load_struct_packed_vec3(const device Light_packed_vec3* const from) {
  return Light{.position=float3((*from).position), .colour=float3((*from).colour)};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v(const device Lights_packed_vec3* lights [[buffer(0)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.lights=lights, .tint_immediate_data=tint_immediate_data};
  (tint_load_struct_packed_vec3((&(*tint_module_vars.lights).light[min(0u, (tint_array_lengths_struct{.tint_array_length_0_0=(((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u] - 0u) / 32u)}.tint_array_length_0_0 - 1u))])));
}
