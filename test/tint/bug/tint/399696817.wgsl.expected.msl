#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  threadgroup atomic_int* a;
};

struct tint_symbol_1 {
  atomic_int tint_symbol;
};

void foo(uint in, tint_module_vars_struct tint_module_vars) {
  int4 const x = (as_type<int4>((uint4(in) << uint4(24u, 16u, 8u, 0u))) >> uint4(24u));
  uint4 const y = ((uint4(in) >> uint4(0u, 8u, 16u, 24u)) & uint4(255u));
  int const z = atomic_load_explicit(tint_module_vars.a, memory_order_relaxed);
}

void main_inner(uint tint_local_index, tint_module_vars_struct tint_module_vars) {
  if ((tint_local_index < 1u)) {
    (atomic_store_explicit(tint_module_vars.a, 0, memory_order_relaxed));
  }
  (threadgroup_barrier(mem_flags::mem_threadgroup));
  (foo(1u, tint_module_vars));
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v(uint tint_local_index [[thread_index_in_threadgroup]], threadgroup tint_symbol_1* v_1 [[threadgroup(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.a=(&(*v_1).tint_symbol)};
  (main_inner(tint_local_index, tint_module_vars));
}
