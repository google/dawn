#include <metal_stdlib>
using namespace metal;

struct S {
  /* 0x0000 */ float4 a;
  /* 0x0010 */ int b;
  /* 0x0014 */ array<int8_t, 12> tint_pad;
};

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad_1;
  /* 0x0800 */ array<uint, 1> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  const device array<S, 1>* sb;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void v(const device array<S, 1>* sb [[buffer(0)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.sb=sb, .tint_immediate_data=tint_immediate_data};
  S const x = (*tint_module_vars.sb)[min(1u, (tint_array_lengths_struct{.tint_array_length_0_0=((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u] / 32u)}.tint_array_length_0_0 - 1u))];
}
