#include <metal_stdlib>
using namespace metal;

struct Matrix {
  /* 0x0000 */ array<uint, 1> numbers;
};

struct Uniforms {
  /* 0x0000 */ uint2 aShape;
  /* 0x0008 */ uint2 bShape;
  /* 0x0010 */ uint2 outShape;
};

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad;
  /* 0x0800 */ array<uint, 3> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  const device Matrix* firstMatrix;
  const device Matrix* secondMatrix;
  device Matrix* resultMatrix;
  const constant Uniforms* uniforms;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_2;
  uint tint_array_length_0_3;
  uint tint_array_length_0_0;
};

void main_inner(uint3 global_id, tint_module_vars_struct tint_module_vars) {
  tint_array_lengths_struct const v = tint_array_lengths_struct{.tint_array_length_0_2=(((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[1u] - 0u) / 4u), .tint_array_length_0_3=(((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[2u] - 0u) / 4u), .tint_array_length_0_0=(((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u] - 0u) / 4u)};
  uint2 const resultCell = uint2(global_id.y, global_id.x);
  uint const dimInner = (*tint_module_vars.uniforms).aShape.y;
  uint const dimOutter = (*tint_module_vars.uniforms).outShape.y;
  uint result = 0u;
  {
    uint2 tint_loop_idx = uint2(4294967295u);
    uint i = 0u;
    while(true) {
      if (all((tint_loop_idx == uint2(0u)))) {
        break;
      }
      if ((i < dimInner)) {
      } else {
        break;
      }
      uint const a = (i + (resultCell.x * dimInner));
      uint const b = (resultCell.y + (i * dimOutter));
      result = (result + ((*tint_module_vars.firstMatrix).numbers[min(a, (v.tint_array_length_0_2 - 1u))] * (*tint_module_vars.secondMatrix).numbers[min(b, (v.tint_array_length_0_3 - 1u))]));
      {
        uint const tint_low_inc = (tint_loop_idx.x - 1u);
        tint_loop_idx.x = tint_low_inc;
        uint const tint_carry = uint((tint_low_inc == 4294967295u));
        tint_loop_idx.y = (tint_loop_idx.y - tint_carry);
        i = (i + 1u);
      }
    }
  }
  uint const index = (resultCell.y + (resultCell.x * dimOutter));
  (*tint_module_vars.resultMatrix).numbers[min(index, (v.tint_array_length_0_0 - 1u))] = result;
}

[[max_total_threads_per_threadgroup(4)]]
kernel void v_1(uint3 global_id [[thread_position_in_grid]], const device Matrix* firstMatrix [[buffer(2)]], const device Matrix* secondMatrix [[buffer(3)]], device Matrix* resultMatrix [[buffer(0)]], const constant Uniforms* uniforms [[buffer(1)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.firstMatrix=firstMatrix, .secondMatrix=secondMatrix, .resultMatrix=resultMatrix, .uniforms=uniforms, .tint_immediate_data=tint_immediate_data};
  (main_inner(global_id, tint_module_vars));
}
