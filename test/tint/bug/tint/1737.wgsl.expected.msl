#include <metal_stdlib>
using namespace metal;

template<typename T, size_t N>
struct tint_array {
  const constant T& operator[](size_t i) const constant { return elements[i]; }
  device T& operator[](size_t i) device { return elements[i]; }
  const device T& operator[](size_t i) const device { return elements[i]; }
  thread T& operator[](size_t i) thread { return elements[i]; }
  const thread T& operator[](size_t i) const thread { return elements[i]; }
  threadgroup T& operator[](size_t i) threadgroup { return elements[i]; }
  const threadgroup T& operator[](size_t i) const threadgroup { return elements[i]; }
  T elements[N];
};

struct tint_module_vars_struct {
  threadgroup tint_array<float, 10>* a;
  threadgroup tint_array<float, 20>* b;
};

struct tint_symbol_2 {
  tint_array<float, 10> tint_symbol;
  tint_array<float, 20> tint_symbol_1;
};

void f_inner(uint tint_local_index, tint_module_vars_struct tint_module_vars) {
  {
    uint idx = tint_local_index;
    while(true) {
      uint const v = idx;
      if ((v >= 10u)) {
        break;
      }
      (*tint_module_vars.a)[v] = 0.0f;
      {
        idx = (idx + 1u);
      }
    }
  }
  {
    uint idx = tint_local_index;
    while(true) {
      uint const v_1 = idx;
      if ((v_1 >= 20u)) {
        break;
      }
      (*tint_module_vars.b)[v_1] = 0.0f;
      {
        idx = (idx + 1u);
      }
    }
  }
  (threadgroup_barrier(mem_flags::mem_threadgroup));
  float const x = (*tint_module_vars.a)[0];
  float const y = (*tint_module_vars.b)[0];
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(uint tint_local_index [[thread_index_in_threadgroup]], threadgroup tint_symbol_2* v_2 [[threadgroup(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.a=(&(*v_2).tint_symbol), .b=(&(*v_2).tint_symbol_1)};
  (f_inner(tint_local_index, tint_module_vars));
}
