#include <metal_stdlib>
using namespace metal;

struct tint_immediate_data_struct {
  /* 0x0000 */ float user_immediate_data;
  /* 0x0004 */ uint tint_non_constant_zero;
};

struct tint_module_vars_struct {
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct main_outputs {
  float4 tint_symbol [[position]];
};

float4 main_inner(uint b, tint_module_vars_struct tint_module_vars) {
  float const v = (*tint_module_vars.tint_immediate_data).user_immediate_data;
  return float4((v + float(b)));
}

vertex main_outputs v_1(uint b [[instance_id]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.tint_immediate_data=tint_immediate_data};
  main_outputs tint_wrapper_result = {};
  tint_wrapper_result.tint_symbol = main_inner(b, tint_module_vars);
  return tint_wrapper_result;
}
