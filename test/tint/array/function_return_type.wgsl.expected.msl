#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  device float* s;
};

array<float, 4> f1() {
  return array<float, 4>{};
}

array<array<float, 4>, 3> f2() {
  array<float, 4> const v = f1();
  array<float, 4> const v_1 = f1();
  return array<array<float, 4>, 3>{v, v_1, f1()};
}

array<array<array<float, 4>, 3>, 2> f3() {
  array<array<float, 4>, 3> const v_2 = f2();
  return array<array<array<float, 4>, 3>, 2>{v_2, f2()};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v_3(device float* s [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.s=s};
  array<float, 4> const a1 = f1();
  array<array<float, 4>, 3> const a2 = f2();
  array<array<array<float, 4>, 3>, 2> const a3 = f3();
  (*tint_module_vars.s) = ((a1[0] + a2[0][0]) + a3[0][0][0]);
}
