#include <metal_stdlib>
using namespace metal;

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad;
  /* 0x0800 */ array<uint, 1> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  device array<uint, 1>* output;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

void main_inner(uint num_subgroups, tint_module_vars_struct tint_module_vars) {
  (*tint_module_vars.output)[min(num_subgroups, (tint_array_lengths_struct{.tint_array_length_0_0=((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u] / 4u)}.tint_array_length_0_0 - 1u))] = num_subgroups;
}

[[max_total_threads_per_threadgroup(64)]]
kernel void v(uint num_subgroups [[simdgroups_per_threadgroup]], device array<uint, 1>* output [[buffer(0)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.output=output, .tint_immediate_data=tint_immediate_data};
  (main_inner(num_subgroups, tint_module_vars));
}
