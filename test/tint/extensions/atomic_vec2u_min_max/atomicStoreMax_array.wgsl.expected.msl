#include <metal_stdlib>
using namespace metal;

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad;
  /* 0x0800 */ array<uint, 1> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  device array<atomic_ulong, 4>* sb_rw0;
  device array<atomic_ulong, 1>* sb_rw1;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_1;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void compute_main(device array<atomic_ulong, 4>* sb_rw0 [[buffer(0)]], device array<atomic_ulong, 1>* sb_rw1 [[buffer(1)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.sb_rw0=sb_rw0, .sb_rw1=sb_rw1, .tint_immediate_data=tint_immediate_data};
  tint_array_lengths_struct const v = tint_array_lengths_struct{.tint_array_length_0_1=((*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u] / 8u)};
  uint2 in_vec = uint2(1u, 2u);
  (atomic_max_explicit((&(*tint_module_vars.sb_rw0)[1]), as_type<ulong>(in_vec), memory_order_relaxed));
  (atomic_max_explicit((&(*tint_module_vars.sb_rw1)[min(1u, (v.tint_array_length_0_1 - 1u))]), as_type<ulong>(in_vec), memory_order_relaxed));
}
