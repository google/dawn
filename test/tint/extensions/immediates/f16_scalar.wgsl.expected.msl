#include <metal_stdlib>
using namespace metal;

struct tint_immediate_data_struct {
  /* 0x0000 */ half user_immediate_data;
  /* 0x0002 */ array<int8_t, 2> tint_pad;
  /* 0x0004 */ uint tint_non_constant_zero;
};

struct tint_module_vars_struct {
  device float* output;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void v(device float* output [[buffer(0)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.output=output, .tint_immediate_data=tint_immediate_data};
  (*tint_module_vars.output) = float((*tint_module_vars.tint_immediate_data).user_immediate_data);
}
