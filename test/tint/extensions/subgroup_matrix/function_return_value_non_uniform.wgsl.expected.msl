[[max_total_threads_per_threadgroup(64)]]
kernel void v_18(uint idx [[thread_index_in_threadgroup]], device tint_array<float, 1>* v_19 [[buffer(0)]], const constant tint_array<uint4, 1>* tint_storage_buffer_sizes [[buffer(30)]]) {
