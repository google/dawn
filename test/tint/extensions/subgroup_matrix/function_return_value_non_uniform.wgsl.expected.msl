    return tint_array<tint_array<simdgroup_float8x8, 2>, 2>{v, tint_array<simdgroup_float8x8, 2>{make_filled_simdgroup_matrix<float, 8, 8>(-7.0f), make_filled_simdgroup_matrix<float, 8, 8>(-42.0f)}};
  } else {
