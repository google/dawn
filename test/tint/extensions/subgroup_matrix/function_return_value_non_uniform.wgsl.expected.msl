    return tint_array<tint_array<simdgroup_float8x8, 2>, 2>{v_1, tint_array<simdgroup_float8x8, 2>{make_filled_simdgroup_matrix<float, 8, 8>(-100.0f), make_filled_simdgroup_matrix<float, 8, 8>(-1.0f)}};
  }
