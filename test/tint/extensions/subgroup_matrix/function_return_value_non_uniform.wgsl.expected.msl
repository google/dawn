S make_struct(tint_module_vars_struct tint_module_vars) {
  if ((*tint_module_vars.non_uniform_condition)) {
    return S{.l=make_filled_simdgroup_matrix<float, 8, 8>(42.0f), .r=make_filled_simdgroup_matrix<float, 8, 8>(100.0f)};
