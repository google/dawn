#include <metal_stdlib>
using namespace metal;

template<typename T, size_t N>
struct tint_array {
  const constant T& operator[](size_t i) const constant { return elements[i]; }
  device T& operator[](size_t i) device { return elements[i]; }
  const device T& operator[](size_t i) const device { return elements[i]; }
  thread T& operator[](size_t i) thread { return elements[i]; }
  const thread T& operator[](size_t i) const thread { return elements[i]; }
  threadgroup T& operator[](size_t i) threadgroup { return elements[i]; }
  const threadgroup T& operator[](size_t i) const threadgroup { return elements[i]; }
  T elements[N];
};

struct S {
  simdgroup_float8x8 l;
  simdgroup_float8x8 r;
};

struct S_Nested {
  S s;
};

struct tint_module_vars_struct {
  device tint_array<float, 1>* tint_member;
  const constant tint_array<uint4, 1>* tint_storage_buffer_sizes;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

simdgroup_float8x8 make_matrix() {
  simdgroup_float8x8 m = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  return m;
}

tint_array<simdgroup_float8x8, 4> make_array() {
  tint_array<simdgroup_float8x8, 4> m_array = {};
  return m_array;
}

tint_array<tint_array<simdgroup_float8x8, 4>, 4> make_nested_array() {
  tint_array<tint_array<simdgroup_float8x8, 4>, 4> m_nested_array = {};
  return m_nested_array;
}

S make_struct() {
  S m_struct = {};
  return m_struct;
}

S_Nested make_nested_struct() {
  S_Nested m_nested_struct = {};
  return m_nested_struct;
}

[[max_total_threads_per_threadgroup(64)]]
kernel void v(device tint_array<float, 1>* v_1 [[buffer(0)]], const constant tint_array<uint4, 1>* tint_storage_buffer_sizes [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.tint_member=v_1, .tint_storage_buffer_sizes=tint_storage_buffer_sizes};
  tint_array_lengths_struct const v_2 = tint_array_lengths_struct{.tint_array_length_0_0=((*tint_module_vars.tint_storage_buffer_sizes)[0u].x / 4u)};
  bool const v_3 = (456u <= v_2.tint_array_length_0_0);
  (simdgroup_store(make_matrix(), (&(*tint_module_vars.tint_member)[select(0u, 0u, v_3)]), ulong(select(8u, 64u, v_3)), ulong2(0ul), false));
  bool const v_4 = (456u <= v_2.tint_array_length_0_0);
  (simdgroup_store(make_array()[0], (&(*tint_module_vars.tint_member)[select(0u, 0u, v_4)]), ulong(select(8u, 64u, v_4)), ulong2(0ul), false));
  bool const v_5 = (456u <= v_2.tint_array_length_0_0);
  (simdgroup_store(make_nested_array()[1][2], (&(*tint_module_vars.tint_member)[select(0u, 0u, v_5)]), ulong(select(8u, 64u, v_5)), ulong2(0ul), false));
  bool const v_6 = (456u <= v_2.tint_array_length_0_0);
  (simdgroup_store(make_struct().l, (&(*tint_module_vars.tint_member)[select(0u, 0u, v_6)]), ulong(select(8u, 64u, v_6)), ulong2(0ul), false));
  bool const v_7 = (456u <= v_2.tint_array_length_0_0);
  (simdgroup_store(make_nested_struct().s.r, (&(*tint_module_vars.tint_member)[select(0u, 0u, v_7)]), ulong(select(8u, 64u, v_7)), ulong2(0ul), false));
}
