  (simdgroup_store(tint_array<simdgroup_float8x8, 2>{make_filled_simdgroup_matrix<float, 8, 8>(42.0f), make_filled_simdgroup_matrix<float, 8, 8>(100.0f)}[1u], (&(*tint_module_vars.tint_member)[select(0u, v_21, v_23)]), ulong(select(8u, v_22, v_23)), ulong2(0ul), false));
  tint_array<simdgroup_float8x8, 2> const v_24 = tint_array<simdgroup_float8x8, 2>{make_filled_simdgroup_matrix<float, 8, 8>(42.0f), make_filled_simdgroup_matrix<float, 8, 8>(100.0f)};
