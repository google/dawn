  bool const v_25 = (addsat(madsat(v_24, 7u, v_23), 8u) <= v_1.tint_array_length_0_6);
  (simdgroup_store(m6, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out) + (select(0u, v_23, v_25) * 4u)), ulong((select(8u, v_24, v_25) * 1u)), ulong2(0ul), true));
