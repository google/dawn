  tint_array_lengths_struct const v_1 = tint_array_lengths_struct{.tint_array_length_0_6=((*tint_module_vars.tint_storage_buffer_sizes)[1u].z / 4u)};
  simdgroup_float8x8 v_2 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  (simdgroup_load(v_2, reinterpret_cast<const device float*>(reinterpret_cast<const device char*>(tint_module_vars.in0) + (0u * 4u)), ulong((16u * 1u)), ulong2(0ul), true));
  simdgroup_float8x8 const m0 = v_2;
  uint const v_3 = as_type<uint>(0);
  uint const v_4 = as_type<uint>(16);
  bool const v_5 = (addsat(madsat(v_4, 7u, v_3), 8u) <= v_1.tint_array_length_0_6);
  (simdgroup_store(m0, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out) + (select(0u, v_3, v_5) * 4u)), ulong((select(8u, v_4, v_5) * 1u)), ulong2(0ul), true));
  simdgroup_float8x8 v_6 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  (simdgroup_load(v_6, reinterpret_cast<const device float*>(reinterpret_cast<const device char*>(tint_module_vars.in1) + (0u * 8u)), ulong((16u * 2u)), ulong2(0ul), true));
  simdgroup_float8x8 const m1 = v_6;
