  (simdgroup_store(m3, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out) + (select(0u, 0u, v_9) * 4u)), ulong((select(8u, 16u, v_9) * 1u)), ulong2(0ul), true));
