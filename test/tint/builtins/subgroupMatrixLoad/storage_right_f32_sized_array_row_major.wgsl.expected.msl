  simdgroup_float8x8 v_6 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  (simdgroup_load(v_6, reinterpret_cast<const device float*>(reinterpret_cast<const device char*>(tint_module_vars.in2) + 0u), ulong(64u), ulong2(0ul), false));
