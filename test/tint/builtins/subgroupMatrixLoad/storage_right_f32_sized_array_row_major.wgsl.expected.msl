  tint_array_lengths_struct const v_1 = tint_array_lengths_struct{.tint_array_length_0_6=((*tint_module_vars.tint_storage_buffer_sizes)[1u].z / 4u)};
  simdgroup_float8x8 v_2 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  (simdgroup_load(v_2, reinterpret_cast<const device float*>(reinterpret_cast<const device char*>(tint_module_vars.in0) + 0u), ulong(16u), ulong2(0ul), false));
  simdgroup_float8x8 const m0 = v_2;
  bool const v_3 = (120u <= v_1.tint_array_length_0_6);
  (simdgroup_store(m0, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out) + (select(0u, 0u, v_3) * 4u)), ulong((select(8u, 16u, v_3) * 1u)), ulong2(0ul), true));
  simdgroup_float8x8 v_4 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  (simdgroup_load(v_4, reinterpret_cast<const device float*>(reinterpret_cast<const device char*>(tint_module_vars.in1) + 0u), ulong(32u), ulong2(0ul), false));
  simdgroup_float8x8 const m1 = v_4;
