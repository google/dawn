kernel void v(const device tint_array<uint, 1024>* in0 [[buffer(0)]], const device tint_array<int2, 1024>* in1 [[buffer(1)]], const device tint_array<tint_packed_vec3_f32_array_element, 1024>* in2 [[buffer(2)]], const device tint_array<uint4, 1024>* in3 [[buffer(3)]], const device tint_array<half2, 1024>* in5 [[buffer(4)]], const device tint_array<tint_packed_vec3_f16_array_element, 1024>* in6 [[buffer(5)]], device tint_array<uint, 1>* out [[buffer(6)]], const constant tint_array<uint4, 2>* tint_storage_buffer_sizes [[buffer(30)]]) {
