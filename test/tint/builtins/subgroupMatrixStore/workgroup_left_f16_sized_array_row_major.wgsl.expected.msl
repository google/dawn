#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  packed_float3 packed;
};

struct tint_packed_vec3_f16_array_element {
  packed_half3 packed_1;
};

struct tint_module_vars_struct {
  threadgroup array<uint, 1024>* out0;
  threadgroup array<int2, 1024>* out1;
  threadgroup array<tint_packed_vec3_f32_array_element, 1024>* out2;
  threadgroup array<uint4, 1024>* out3;
  threadgroup array<half, 1024>* out4;
  threadgroup array<half2, 1024>* out5;
  threadgroup array<tint_packed_vec3_f16_array_element, 1024>* out6;
};

struct tint_symbol_7 {
  array<uint, 1024> tint_symbol;
  array<int2, 1024> tint_symbol_1;
  array<tint_packed_vec3_f32_array_element, 1024> tint_symbol_2;
  array<uint4, 1024> tint_symbol_3;
  array<half, 1024> tint_symbol_4;
  array<half2, 1024> tint_symbol_5;
  array<tint_packed_vec3_f16_array_element, 1024> tint_symbol_6;
};

void main_inner(uint tint_local_index, tint_module_vars_struct tint_module_vars) {
  {
    uint idx = tint_local_index;
    while(true) {
      uint const v = idx;
      if ((v >= 1024u)) {
        break;
      }
      (*tint_module_vars.out0)[v] = 0u;
      (*tint_module_vars.out1)[v] = int2(0);
      (*tint_module_vars.out2)[v].packed = packed_float3(float3(0.0f));
      (*tint_module_vars.out3)[v] = uint4(0u);
      (*tint_module_vars.out4)[v] = 0.0h;
      (*tint_module_vars.out5)[v] = half2(0.0h);
      (*tint_module_vars.out6)[v].packed_1 = packed_half3(half3(0.0h));
      {
        idx = (idx + 64u);
      }
    }
  }
  (threadgroup_barrier(mem_flags::mem_threadgroup));
  simdgroup_half8x8 const m = make_filled_simdgroup_matrix<half, 8, 8>(0.0h);
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out0) + 0u), ulong(32u), ulong2(0ul), false));
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out1) + 0u), ulong(64u), ulong2(0ul), false));
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out2) + 0u), ulong(128u), ulong2(0ul), false));
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out3) + 0u), ulong(128u), ulong2(0ul), false));
  (simdgroup_store(m, (&(*tint_module_vars.out4)[0u]), ulong(16u), ulong2(0ul), false));
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out5) + 0u), ulong(32u), ulong2(0ul), false));
  (simdgroup_store(m, reinterpret_cast<threadgroup half*>(reinterpret_cast<threadgroup char*>(tint_module_vars.out6) + 0u), ulong(64u), ulong2(0ul), false));
}

[[max_total_threads_per_threadgroup(64)]]
kernel void v_1(uint tint_local_index [[thread_index_in_threadgroup]], threadgroup tint_symbol_7* v_2 [[threadgroup(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.out0=(&(*v_2).tint_symbol), .out1=(&(*v_2).tint_symbol_1), .out2=(&(*v_2).tint_symbol_2), .out3=(&(*v_2).tint_symbol_3), .out4=(&(*v_2).tint_symbol_4), .out5=(&(*v_2).tint_symbol_5), .out6=(&(*v_2).tint_symbol_6)};
  (main_inner(tint_local_index, tint_module_vars));
}
