#include <metal_stdlib>
using namespace metal;

template<typename T, size_t N>
struct tint_array {
  const constant T& operator[](size_t i) const constant { return elements[i]; }
  device T& operator[](size_t i) device { return elements[i]; }
  const device T& operator[](size_t i) const device { return elements[i]; }
  thread T& operator[](size_t i) thread { return elements[i]; }
  const thread T& operator[](size_t i) const thread { return elements[i]; }
  threadgroup T& operator[](size_t i) threadgroup { return elements[i]; }
  const threadgroup T& operator[](size_t i) const threadgroup { return elements[i]; }
  T elements[N];
};

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ tint_array<int8_t, 4> tint_pad;
};

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed_1;
  /* 0x0006 */ tint_array<int8_t, 2> tint_pad_1;
};

struct tint_module_vars_struct {
  device tint_array<uint, 1>* out0;
  device tint_array<int2, 1>* out1;
  device tint_array<tint_packed_vec3_f32_array_element, 1>* out2;
  device tint_array<uint4, 1>* out3;
  device tint_array<half2, 1>* out5;
  device tint_array<tint_packed_vec3_f16_array_element, 1>* out6;
  const constant tint_array<uint4, 2>* tint_storage_buffer_sizes;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
  uint tint_array_length_0_1;
  uint tint_array_length_0_2;
  uint tint_array_length_0_3;
  uint tint_array_length_0_4;
  uint tint_array_length_0_5;
};

[[max_total_threads_per_threadgroup(64)]]
kernel void v(device tint_array<uint, 1>* out0 [[buffer(0)]], device tint_array<int2, 1>* out1 [[buffer(1)]], device tint_array<tint_packed_vec3_f32_array_element, 1>* out2 [[buffer(2)]], device tint_array<uint4, 1>* out3 [[buffer(3)]], device tint_array<half2, 1>* out5 [[buffer(4)]], device tint_array<tint_packed_vec3_f16_array_element, 1>* out6 [[buffer(5)]], const constant tint_array<uint4, 2>* tint_storage_buffer_sizes [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.out0=out0, .out1=out1, .out2=out2, .out3=out3, .out5=out5, .out6=out6, .tint_storage_buffer_sizes=tint_storage_buffer_sizes};
  tint_array_lengths_struct const v_1 = tint_array_lengths_struct{.tint_array_length_0_0=((*tint_module_vars.tint_storage_buffer_sizes)[0u].x / 4u), .tint_array_length_0_1=((*tint_module_vars.tint_storage_buffer_sizes)[0u].y / 8u), .tint_array_length_0_2=((*tint_module_vars.tint_storage_buffer_sizes)[0u].z / 16u), .tint_array_length_0_3=((*tint_module_vars.tint_storage_buffer_sizes)[0u].w / 16u), .tint_array_length_0_4=((*tint_module_vars.tint_storage_buffer_sizes)[1u].x / 4u), .tint_array_length_0_5=((*tint_module_vars.tint_storage_buffer_sizes)[1u].y / 8u)};
  simdgroup_float8x8 const m = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  uint const v_2 = as_type<uint>(0);
  bool const v_3 = (addsat(madsat(16u, 7u, v_2), 8u) <= v_1.tint_array_length_0_0);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out0) + (select(0u, v_2, v_3) * 4u)), ulong((select(8u, 16u, v_3) * 1u)), ulong2(0ul), true));
  uint const v_4 = as_type<uint>(0);
  bool const v_5 = (addsat(madsat(16u, 7u, v_4), 4u) <= v_1.tint_array_length_0_1);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out1) + (select(0u, v_4, v_5) * 8u)), ulong((select(4u, 16u, v_5) * 2u)), ulong2(0ul), true));
  uint const v_6 = as_type<uint>(0);
  bool const v_7 = (addsat(madsat(16u, 7u, v_6), 2u) <= v_1.tint_array_length_0_2);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out2) + (select(0u, v_6, v_7) * 16u)), ulong((select(2u, 16u, v_7) * 4u)), ulong2(0ul), true));
  uint const v_8 = as_type<uint>(0);
  bool const v_9 = (addsat(madsat(16u, 7u, v_8), 2u) <= v_1.tint_array_length_0_3);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out3) + (select(0u, v_8, v_9) * 16u)), ulong((select(2u, 16u, v_9) * 4u)), ulong2(0ul), true));
  uint const v_10 = as_type<uint>(0);
  bool const v_11 = (addsat(madsat(16u, 7u, v_10), 8u) <= v_1.tint_array_length_0_4);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out5) + (select(0u, v_10, v_11) * 4u)), ulong((select(8u, 16u, v_11) * 1u)), ulong2(0ul), true));
  uint const v_12 = as_type<uint>(0);
  bool const v_13 = (addsat(madsat(16u, 7u, v_12), 4u) <= v_1.tint_array_length_0_5);
  (simdgroup_store(m, reinterpret_cast<device float*>(reinterpret_cast<device char*>(tint_module_vars.out6) + (select(0u, v_12, v_13) * 8u)), ulong((select(4u, 16u, v_13) * 2u)), ulong2(0ul), true));
}
