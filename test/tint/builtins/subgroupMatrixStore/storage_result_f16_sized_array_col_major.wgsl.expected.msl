#include <metal_stdlib>
using namespace metal;

template<typename T, size_t N>
struct tint_array {
  const constant T& operator[](size_t i) const constant { return elements[i]; }
  device T& operator[](size_t i) device { return elements[i]; }
  const device T& operator[](size_t i) const device { return elements[i]; }
  thread T& operator[](size_t i) thread { return elements[i]; }
  const thread T& operator[](size_t i) const thread { return elements[i]; }
  threadgroup T& operator[](size_t i) threadgroup { return elements[i]; }
  const threadgroup T& operator[](size_t i) const threadgroup { return elements[i]; }
  T elements[N];
};

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ tint_array<int8_t, 4> tint_pad;
};

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed_1;
  /* 0x0006 */ tint_array<int8_t, 2> tint_pad_1;
};

struct tint_module_vars_struct {
  device tint_array<uint, 1024>* out0;
  device tint_array<int2, 1024>* out1;
  device tint_array<tint_packed_vec3_f32_array_element, 1024>* out2;
  device tint_array<uint4, 1024>* out3;
  device tint_array<half, 1024>* out4;
  device tint_array<half2, 1024>* out5;
  device tint_array<tint_packed_vec3_f16_array_element, 1024>* out6;
};

[[max_total_threads_per_threadgroup(64)]]
kernel void v(device tint_array<uint, 1024>* out0 [[buffer(0)]], device tint_array<int2, 1024>* out1 [[buffer(1)]], device tint_array<tint_packed_vec3_f32_array_element, 1024>* out2 [[buffer(2)]], device tint_array<uint4, 1024>* out3 [[buffer(3)]], device tint_array<half, 1024>* out4 [[buffer(4)]], device tint_array<half2, 1024>* out5 [[buffer(5)]], device tint_array<tint_packed_vec3_f16_array_element, 1024>* out6 [[buffer(6)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.out0=out0, .out1=out1, .out2=out2, .out3=out3, .out4=out4, .out5=out5, .out6=out6};
  simdgroup_half8x8 const m = make_filled_simdgroup_matrix<half, 8, 8>(0.0h);
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out0) + 0u), ulong(32u), ulong2(0ul), true));
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out1) + 0u), ulong(64u), ulong2(0ul), true));
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out2) + 0u), ulong(128u), ulong2(0ul), true));
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out3) + 0u), ulong(128u), ulong2(0ul), true));
  (simdgroup_store(m, (&(*tint_module_vars.out4)[0]), ulong(16u), ulong2(0ul), true));
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out5) + 0u), ulong(32u), ulong2(0ul), true));
  (as_type<uint>(0));
  (simdgroup_store(m, reinterpret_cast<device half*>(reinterpret_cast<device char*>(tint_module_vars.out6) + 0u), ulong(64u), ulong2(0ul), true));
}
