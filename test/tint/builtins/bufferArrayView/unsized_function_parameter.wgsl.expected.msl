#include <metal_stdlib>
using namespace metal;
typedef array<float2, 1> __attribute__((__may_alias__)) tint_aliased_array_vec2_f32;

struct tint_immediate_data_struct {
  /* 0x0000 */ uint tint_non_constant_zero;
  /* 0x0004 */ array<int8_t, 2044> tint_pad;
  /* 0x0800 */ array<uint, 1> tint_storage_buffer_sizes;
};

struct tint_module_vars_struct {
  device array<uchar, 1>* v;
  const constant tint_immediate_data_struct* tint_immediate_data;
};

struct tint_array_lengths_struct {
  uint tint_array_length_0_0;
};

void foo(device array<uchar, 1>* const p, uint tint_array_length) {
  bool const v_1 = (tint_array_length < 32u);
  device tint_aliased_array_vec2_f32* const v_2 = reinterpret_cast<device array<float2, 1>*>(reinterpret_cast<device char*>(p) + select(0u, 0u, v_1));
  device tint_aliased_array_vec2_f32* const p2 = v_2;
  (*p2)[min(0u, ((select(32u, 8u, v_1) / 8u) - 1u))].y = 3.0f;
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v_3(device array<uchar, 1>* v [[buffer(0)]], const constant tint_immediate_data_struct* tint_immediate_data [[buffer(30)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.v=v, .tint_immediate_data=tint_immediate_data};
  (foo(tint_module_vars.v, tint_array_lengths_struct{.tint_array_length_0_0=(*tint_module_vars.tint_immediate_data).tint_storage_buffer_sizes[0u]}.tint_array_length_0_0));
}
