#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  const constant array<uchar, 128>* v;
  device float2* out;
};

struct S_packed_vec3 {
  /* 0x0000 */ float4 a;
  /* 0x0010 */ packed_float3 b;
  /* 0x001c */ array<int8_t, 4> tint_pad;
  /* 0x0020 */ float2 c;
  /* 0x0028 */ array<int8_t, 8> tint_pad_1;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void v_1(const constant array<uchar, 128>* v [[buffer(0)]], device float2* out [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.v=v, .out=out};
  const constant S_packed_vec3* const p = reinterpret_cast<const constant S_packed_vec3*>(reinterpret_cast<const constant char*>(tint_module_vars.v) + 0u);
  (*tint_module_vars.out) = (*p).c;
}
