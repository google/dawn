#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  thread array<float2, 2>* arr;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f() {
  thread array<float2, 2> arr = array<float2, 2>{float2(1.0f), float2(2.0f)};
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.arr=(&arr)};
  array<float2, 2> v = (*tint_module_vars.arr);
}
