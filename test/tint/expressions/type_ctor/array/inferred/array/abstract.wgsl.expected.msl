#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  thread array<array<int, 2>, 2>* arr;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f() {
  thread array<array<int, 2>, 2> arr = array<array<int, 2>, 2>{array<int, 2>{1, 2}, array<int, 2>{3, 4}};
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.arr=(&arr)};
  array<array<int, 2>, 2> v = (*tint_module_vars.arr);
}
