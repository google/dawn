#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  thread array<array<float, 2>, 2>* arr;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f() {
  thread array<array<float, 2>, 2> arr = array<array<float, 2>, 2>{array<float, 2>{1.0f, 2.0f}, array<float, 2>{3.0f, 4.0f}};
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.arr=(&arr)};
  array<array<float, 2>, 2> v = (*tint_module_vars.arr);
}
