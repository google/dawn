#include <metal_stdlib>
using namespace metal;

int c(int z) {
  int a = as_type<int>((1u + as_type<uint>(z)));
  a = as_type<int>((as_type<uint>(a) + 2u));
  return a;
}

[[max_total_threads_per_threadgroup(1)]]
kernel void b() {
  int b_1 = c(2);
  int const v = b_1;
  b_1 = as_type<int>((as_type<uint>(v) + as_type<uint>(c(3))));
}
