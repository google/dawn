#include <metal_stdlib>
using namespace metal;

int c(int x, int y, int z) {
  int a = as_type<int>((as_type<uint>(as_type<int>((as_type<uint>(as_type<int>((1u + as_type<uint>(x)))) + as_type<uint>(y)))) + as_type<uint>(z)));
  a = as_type<int>((as_type<uint>(a) + 2u));
  return a;
}

[[max_total_threads_per_threadgroup(1)]]
kernel void b() {
  int b_1 = c(2, 3, 4);
  int const v = b_1;
  b_1 = as_type<int>((as_type<uint>(v) + as_type<uint>(c(3, 4, 5))));
}
