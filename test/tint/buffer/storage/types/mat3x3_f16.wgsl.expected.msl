#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed;
  /* 0x0006 */ array<int8_t, 2> tint_pad;
};

struct tint_module_vars_struct {
  const device array<tint_packed_vec3_f16_array_element, 3>* in;
  device array<tint_packed_vec3_f16_array_element, 3>* out;
};

void tint_store_and_preserve_padding(device array<tint_packed_vec3_f16_array_element, 3>* const target, half3x3 value_param) {
  (*target)[0u].packed = packed_half3(value_param[0u]);
  (*target)[1u].packed = packed_half3(value_param[1u]);
  (*target)[2u].packed = packed_half3(value_param[2u]);
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v(const device array<tint_packed_vec3_f16_array_element, 3>* in [[buffer(0)]], device array<tint_packed_vec3_f16_array_element, 3>* out [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.in=in, .out=out};
  array<tint_packed_vec3_f16_array_element, 3> const v_1 = (*tint_module_vars.in);
  (tint_store_and_preserve_padding(tint_module_vars.out, half3x3(half3(v_1[0u].packed), half3(v_1[1u].packed), half3(v_1[2u].packed))));
}
