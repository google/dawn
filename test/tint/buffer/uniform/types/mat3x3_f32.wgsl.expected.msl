#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f32_array_element, 3>* u;
  device array<tint_packed_vec3_f32_array_element, 3>* s;
};

void tint_store_and_preserve_padding(device array<tint_packed_vec3_f32_array_element, 3>* const target, float3x3 value_param) {
  (*target)[0u].packed = packed_float3(value_param[0u]);
  (*target)[1u].packed = packed_float3(value_param[1u]);
  (*target)[2u].packed = packed_float3(value_param[2u]);
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v(const constant array<tint_packed_vec3_f32_array_element, 3>* u [[buffer(0)]], device array<tint_packed_vec3_f32_array_element, 3>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  array<tint_packed_vec3_f32_array_element, 3> const v_1 = (*tint_module_vars.u);
  float3x3 const x = float3x3(float3(v_1[0u].packed), float3(v_1[1u].packed), float3(v_1[2u].packed));
  (tint_store_and_preserve_padding(tint_module_vars.s, x));
}
