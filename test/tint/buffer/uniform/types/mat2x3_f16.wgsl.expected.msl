#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed;
  /* 0x0006 */ array<int8_t, 2> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f16_array_element, 2>* u;
  device array<tint_packed_vec3_f16_array_element, 2>* s;
};

void tint_store_and_preserve_padding(device array<tint_packed_vec3_f16_array_element, 2>* const target, half2x3 value_param) {
  (*target)[0u].packed = packed_half3(value_param[0u]);
  (*target)[1u].packed = packed_half3(value_param[1u]);
}

[[max_total_threads_per_threadgroup(1)]]
kernel void v(const constant array<tint_packed_vec3_f16_array_element, 2>* u [[buffer(0)]], device array<tint_packed_vec3_f16_array_element, 2>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  array<tint_packed_vec3_f16_array_element, 2> const v_1 = (*tint_module_vars.u);
  half2x3 const x = half2x3(half3(v_1[0u].packed), half3(v_1[1u].packed));
  (tint_store_and_preserve_padding(tint_module_vars.s, x));
}
