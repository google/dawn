#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f32_array_element, 2>* u;
  device array<tint_packed_vec3_f32_array_element, 2>* s;
};

void tint_store_and_preserve_padding(device array<tint_packed_vec3_f32_array_element, 2>* const target, float2x3 value_param) {
  (*target)[0u].packed = packed_float3(value_param[0u]);
  (*target)[1u].packed = packed_float3(value_param[1u]);
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<tint_packed_vec3_f32_array_element, 2>* u [[buffer(0)]], device array<tint_packed_vec3_f32_array_element, 2>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  array<tint_packed_vec3_f32_array_element, 2> const v = (*tint_module_vars.u);
  (tint_store_and_preserve_padding(tint_module_vars.s, float2x3(float3(v[0u].packed), float3(v[1u].packed))));
  (*tint_module_vars.s)[1].packed = packed_float3(float3((*tint_module_vars.u)[0].packed));
  (*tint_module_vars.s)[1].packed = packed_float3(float3((*tint_module_vars.u)[0].packed).zxy);
  (*tint_module_vars.s)[0].packed.y = (*tint_module_vars.u)[1].packed.x;
}
