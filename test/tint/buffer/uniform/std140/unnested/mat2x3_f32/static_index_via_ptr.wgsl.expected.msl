#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f32_array_element, 2>* m;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<tint_packed_vec3_f32_array_element, 2>* m [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.m=m};
  const constant array<tint_packed_vec3_f32_array_element, 2>* const p_m = tint_module_vars.m;
  const constant packed_float3* const p_m_1 = (&(*p_m)[1].packed);
  array<tint_packed_vec3_f32_array_element, 2> const v = (*p_m);
  float2x3 const l_m = float2x3(float3(v[0u].packed), float3(v[1u].packed));
  float3 const l_m_1 = float3((*p_m_1));
}
