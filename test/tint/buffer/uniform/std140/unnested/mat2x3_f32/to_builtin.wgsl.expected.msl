#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f32_array_element, 2>* u;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<tint_packed_vec3_f32_array_element, 2>* u [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u};
  array<tint_packed_vec3_f32_array_element, 2> const v = (*tint_module_vars.u);
  float3x2 const t = transpose(float2x3(float3(v[0u].packed), float3(v[1u].packed)));
  float const l = length(float3((*tint_module_vars.u)[1].packed));
  float const a = abs((*tint_module_vars.u)[0].packed.z);
}
