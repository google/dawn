#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed;
  /* 0x0006 */ array<int8_t, 2> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<tint_packed_vec3_f16_array_element, 4>* u;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<tint_packed_vec3_f16_array_element, 4>* u [[buffer(0)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u};
  array<tint_packed_vec3_f16_array_element, 4> const v = (*tint_module_vars.u);
  half3x4 const t = transpose(half4x3(half3(v[0u].packed), half3(v[1u].packed), half3(v[2u].packed), half3(v[3u].packed)));
  half const l = length(half3((*tint_module_vars.u)[1].packed));
  half const a = abs((*tint_module_vars.u)[0].packed.z);
