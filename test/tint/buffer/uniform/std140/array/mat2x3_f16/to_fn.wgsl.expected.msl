#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f16_array_element {
  /* 0x0000 */ packed_half3 packed;
  /* 0x0006 */ array<int8_t, 2> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<array<tint_packed_vec3_f16_array_element, 2>, 4>* u;
  device half* s;
};

half a(array<half2x3, 4> a_1) {
  return a_1[0][0].x;
}

half b(half2x3 m) {
  return m[0].x;
}

half c(half3 v) {
  return v.x;
}

half d(half f_1) {
  return f_1;
}

array<half2x3, 4> tint_load_array_packed_vec3(const constant array<array<tint_packed_vec3_f16_array_element, 2>, 4>* const from) {
  array<tint_packed_vec3_f16_array_element, 2> const v_1 = (*from)[0u];
  half2x3 const v_2 = half2x3(half3(v_1[0u].packed), half3(v_1[1u].packed));
  array<tint_packed_vec3_f16_array_element, 2> const v_3 = (*from)[1u];
  half2x3 const v_4 = half2x3(half3(v_3[0u].packed), half3(v_3[1u].packed));
  array<tint_packed_vec3_f16_array_element, 2> const v_5 = (*from)[2u];
  half2x3 const v_6 = half2x3(half3(v_5[0u].packed), half3(v_5[1u].packed));
  array<tint_packed_vec3_f16_array_element, 2> const v_7 = (*from)[3u];
  return array<half2x3, 4>{v_2, v_4, v_6, half2x3(half3(v_7[0u].packed), half3(v_7[1u].packed))};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<array<tint_packed_vec3_f16_array_element, 2>, 4>* u [[buffer(0)]], device half* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  half const v_8 = a(tint_load_array_packed_vec3(tint_module_vars.u));
  array<tint_packed_vec3_f16_array_element, 2> const v_9 = (*tint_module_vars.u)[1];
  half const v_10 = (v_8 + b(half2x3(half3(v_9[0u].packed), half3(v_9[1u].packed))));
  half const v_11 = (v_10 + c(half3((*tint_module_vars.u)[1][0].packed).zxy));
  (*tint_module_vars.s) = (v_11 + d((*tint_module_vars.u)[1][0].packed.z));
}
