#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  const constant array<half2x4, 4>* u;
  device half* s;
};

half a(array<half2x4, 4> a_1) {
  return a_1[0][0].x;
}

half b(half2x4 m) {
  return m[0].x;
}

half c(half4 v) {
  return v.x;
}

half d(half f_1) {
  return f_1;
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<half2x4, 4>* u [[buffer(0)]], device half* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  half const v_1 = a((*tint_module_vars.u));
  half const v_2 = (v_1 + b((*tint_module_vars.u)[1]));
  half const v_3 = (v_2 + c((*tint_module_vars.u)[1][0].ywxz));
  (*tint_module_vars.s) = (v_3 + d((*tint_module_vars.u)[1][0].y));
}
