#include <metal_stdlib>
using namespace metal;

struct tint_module_vars_struct {
  const constant array<half4x4, 4>* u;
  device array<half4x4, 4>* s;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<half4x4, 4>* u [[buffer(0)]], device array<half4x4, 4>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  (*tint_module_vars.s) = (*tint_module_vars.u);
  (*tint_module_vars.s)[1] = (*tint_module_vars.u)[2];
  (*tint_module_vars.s)[1][0] = (*tint_module_vars.u)[0][1].ywxz;
  (*tint_module_vars.s)[1][0].x = (*tint_module_vars.u)[0][1].x;
}
