#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* u;
  device float* s;
};

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* u [[buffer(0)]], device float* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  array<tint_packed_vec3_f32_array_element, 3> const v = (*tint_module_vars.u)[2];
  float3x3 const t = transpose(float3x3(float3(v[0u].packed), float3(v[1u].packed), float3(v[2u].packed)));
  float const l = length(float3((*tint_module_vars.u)[0][1].packed).zxy);
  float const a = abs((*tint_module_vars.u)[0][1].packed.z);
  float const v_1 = (t[0].x + float(l));
  (*tint_module_vars.s) = (v_1 + float(a));
}
