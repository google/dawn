#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct tint_module_vars_struct {
  const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* u;
  device array<array<tint_packed_vec3_f32_array_element, 3>, 4>* s;
};

void tint_store_and_preserve_padding_1(device array<tint_packed_vec3_f32_array_element, 3>* const target, float3x3 value_param) {
  (*target)[0u].packed = packed_float3(value_param[0u]);
  (*target)[1u].packed = packed_float3(value_param[1u]);
  (*target)[2u].packed = packed_float3(value_param[2u]);
}

void tint_store_and_preserve_padding(device array<array<tint_packed_vec3_f32_array_element, 3>, 4>* const target, array<float3x3, 4> value_param) {
  {
    uint idx = 0u;
    while(true) {
      uint const v = idx;
      if ((v >= 4u)) {
        break;
      }
      (tint_store_and_preserve_padding_1((&(*target)[v]), value_param[v]));
      {
        idx = (idx + 1u);
      }
    }
  }
}

array<float3x3, 4> tint_load_array_packed_vec3(const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* const from) {
  array<tint_packed_vec3_f32_array_element, 3> const v_1 = (*from)[0u];
  float3x3 const v_2 = float3x3(float3(v_1[0u].packed), float3(v_1[1u].packed), float3(v_1[2u].packed));
  array<tint_packed_vec3_f32_array_element, 3> const v_3 = (*from)[1u];
  float3x3 const v_4 = float3x3(float3(v_3[0u].packed), float3(v_3[1u].packed), float3(v_3[2u].packed));
  array<tint_packed_vec3_f32_array_element, 3> const v_5 = (*from)[2u];
  float3x3 const v_6 = float3x3(float3(v_5[0u].packed), float3(v_5[1u].packed), float3(v_5[2u].packed));
  array<tint_packed_vec3_f32_array_element, 3> const v_7 = (*from)[3u];
  return array<float3x3, 4>{v_2, v_4, v_6, float3x3(float3(v_7[0u].packed), float3(v_7[1u].packed), float3(v_7[2u].packed))};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* u [[buffer(0)]], device array<array<tint_packed_vec3_f32_array_element, 3>, 4>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  (tint_store_and_preserve_padding(tint_module_vars.s, tint_load_array_packed_vec3(tint_module_vars.u)));
  array<tint_packed_vec3_f32_array_element, 3> const v_8 = (*tint_module_vars.u)[2];
  (tint_store_and_preserve_padding_1((&(*tint_module_vars.s)[1]), float3x3(float3(v_8[0u].packed), float3(v_8[1u].packed), float3(v_8[2u].packed))));
  (*tint_module_vars.s)[1][0].packed = packed_float3(float3((*tint_module_vars.u)[0][1].packed).zxy);
  (*tint_module_vars.s)[1][0].packed.x = (*tint_module_vars.u)[0][1].packed.x;
}
