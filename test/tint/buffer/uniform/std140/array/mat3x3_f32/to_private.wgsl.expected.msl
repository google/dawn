  array<tint_packed_vec3_f32_array_element, 3> const v_6 = (*from)[3u];
  return array<float3x3, 4>{v_1, v_3, v_5, float3x3(float3(v_6[0u].packed), float3(v_6[1u].packed), float3(v_6[2u].packed))};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* u [[buffer(0)]], device float* s [[buffer(1)]]) {
  thread array<float3x3, 4> p = {};
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s, .p=(&p)};
  (*tint_module_vars.p) = tint_load_array_packed_vec3(tint_module_vars.u);
  array<tint_packed_vec3_f32_array_element, 3> const v_7 = (*tint_module_vars.u)[2];
  (*tint_module_vars.p)[1] = float3x3(float3(v_7[0u].packed), float3(v_7[1u].packed), float3(v_7[2u].packed));
  (*tint_module_vars.p)[1][0] = float3((*tint_module_vars.u)[0][1].packed).zxy;
  (*tint_module_vars.p)[1][0].x = (*tint_module_vars.u)[0][1].packed.x;
  (*tint_module_vars.s) = (*tint_module_vars.p)[1][0].x;
