array<float3x3, 4> tint_load_array_packed_vec3(const constant array<array<tint_packed_vec3_f32_array_element, 3>, 4>* const from) {
  array<tint_packed_vec3_f32_array_element, 3> const v = (*from)[0u];
  float3x3 const v_1 = float3x3(float3(v[0u].packed), float3(v[1u].packed), float3(v[2u].packed));
  array<tint_packed_vec3_f32_array_element, 3> const v_2 = (*from)[1u];
  float3x3 const v_3 = float3x3(float3(v_2[0u].packed), float3(v_2[1u].packed), float3(v_2[2u].packed));
  array<tint_packed_vec3_f32_array_element, 3> const v_4 = (*from)[2u];
