#include <metal_stdlib>
using namespace metal;

struct S {
  int before;
  float3x3 m;
  int after;
};

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad_1;
};

struct S_packed_vec3 {
  /* 0x0000 */ int before;
  /* 0x0004 */ array<int8_t, 12> tint_pad;
  /* 0x0010 */ array<tint_packed_vec3_f32_array_element, 3> m;
  /* 0x0040 */ int after;
  /* 0x0044 */ array<int8_t, 60> tint_pad_2;
};

struct tint_module_vars_struct {
  const constant array<S_packed_vec3, 4>* u;
  thread array<S, 4>* p;
};

S tint_load_struct_packed_vec3(const constant S_packed_vec3* const from) {
  int const v = (*from).before;
  array<tint_packed_vec3_f32_array_element, 3> const v_1 = (*from).m;
  float3x3 const v_2 = float3x3(float3(v_1[0u].packed), float3(v_1[1u].packed), float3(v_1[2u].packed));
  return S{.before=v, .m=v_2, .after=(*from).after};
}

array<S, 4> tint_load_array_packed_vec3(const constant array<S_packed_vec3, 4>* const from) {
  S const v_3 = tint_load_struct_packed_vec3((&(*from)[0u]));
  S const v_4 = tint_load_struct_packed_vec3((&(*from)[1u]));
  S const v_5 = tint_load_struct_packed_vec3((&(*from)[2u]));
  return array<S, 4>{v_3, v_4, v_5, tint_load_struct_packed_vec3((&(*from)[3u]))};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<S_packed_vec3, 4>* u [[buffer(0)]]) {
  thread array<S, 4> p = {};
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .p=(&p)};
  (*tint_module_vars.p) = tint_load_array_packed_vec3(tint_module_vars.u);
  (*tint_module_vars.p)[1] = tint_load_struct_packed_vec3((&(*tint_module_vars.u)[2]));
  array<tint_packed_vec3_f32_array_element, 3> const v_6 = (*tint_module_vars.u)[2].m;
  (*tint_module_vars.p)[3].m = float3x3(float3(v_6[0u].packed), float3(v_6[1u].packed), float3(v_6[2u].packed));
  (*tint_module_vars.p)[1].m[0] = float3((*tint_module_vars.u)[0].m[1].packed).zxy;
}
