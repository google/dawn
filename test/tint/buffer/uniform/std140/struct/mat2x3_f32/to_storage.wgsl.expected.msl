#include <metal_stdlib>
using namespace metal;

struct tint_packed_vec3_f32_array_element {
  /* 0x0000 */ packed_float3 packed;
  /* 0x000c */ array<int8_t, 4> tint_pad;
};

struct S_packed_vec3 {
  /* 0x0000 */ int before;
  /* 0x0004 */ array<int8_t, 12> tint_pad_1;
  /* 0x0010 */ array<tint_packed_vec3_f32_array_element, 2> m;
  /* 0x0030 */ array<int8_t, 16> tint_pad_2;
  /* 0x0040 */ int after;
  /* 0x0044 */ array<int8_t, 60> tint_pad_3;
};

struct S {
  int before;
  float2x3 m;
  int after;
};

struct tint_module_vars_struct {
  const constant array<S_packed_vec3, 4>* u;
  device array<S_packed_vec3, 4>* s;
};

void tint_store_and_preserve_padding_2(device array<tint_packed_vec3_f32_array_element, 2>* const target, float2x3 value_param) {
  (*target)[0u].packed = packed_float3(value_param[0u]);
  (*target)[1u].packed = packed_float3(value_param[1u]);
}

void tint_store_and_preserve_padding_1(device S_packed_vec3* const target, S value_param) {
  (*target).before = value_param.before;
  (tint_store_and_preserve_padding_2((&(*target).m), value_param.m));
  (*target).after = value_param.after;
}

S tint_load_struct_packed_vec3(const constant S_packed_vec3* const from) {
  int const v = (*from).before;
  array<tint_packed_vec3_f32_array_element, 2> const v_1 = (*from).m;
  float2x3 const v_2 = float2x3(float3(v_1[0u].packed), float3(v_1[1u].packed));
  return S{.before=v, .m=v_2, .after=(*from).after};
}

void tint_store_and_preserve_padding(device array<S_packed_vec3, 4>* const target, array<S, 4> value_param) {
  {
    uint v_3 = 0u;
    v_3 = 0u;
    while(true) {
      uint const v_4 = v_3;
      if ((v_4 >= 4u)) {
        break;
      }
      (tint_store_and_preserve_padding_1((&(*target)[v_4]), value_param[v_4]));
      {
        v_3 = (v_4 + 1u);
      }
    }
  }
}

array<S, 4> tint_load_array_packed_vec3(const constant array<S_packed_vec3, 4>* const from) {
  S const v_5 = tint_load_struct_packed_vec3((&(*from)[0u]));
  S const v_6 = tint_load_struct_packed_vec3((&(*from)[1u]));
  S const v_7 = tint_load_struct_packed_vec3((&(*from)[2u]));
  return array<S, 4>{v_5, v_6, v_7, tint_load_struct_packed_vec3((&(*from)[3u]))};
}

[[max_total_threads_per_threadgroup(1)]]
kernel void f(const constant array<S_packed_vec3, 4>* u [[buffer(0)]], device array<S_packed_vec3, 4>* s [[buffer(1)]]) {
  tint_module_vars_struct const tint_module_vars = tint_module_vars_struct{.u=u, .s=s};
  (tint_store_and_preserve_padding(tint_module_vars.s, tint_load_array_packed_vec3(tint_module_vars.u)));
  (tint_store_and_preserve_padding_1((&(*tint_module_vars.s)[1]), tint_load_struct_packed_vec3((&(*tint_module_vars.u)[2]))));
  array<tint_packed_vec3_f32_array_element, 2> const v_8 = (*tint_module_vars.u)[2].m;
  (tint_store_and_preserve_padding_2((&(*tint_module_vars.s)[3].m), float2x3(float3(v_8[0u].packed), float3(v_8[1u].packed))));
  (*tint_module_vars.s)[1].m[0].packed = packed_float3(float3((*tint_module_vars.u)[0].m[1].packed).zxy);
}
