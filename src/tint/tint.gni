###############################################################################
# Fuzzers - Specific targets are guarded by if their dependencies
#           (e.g. IR binary) are included in the build
###############################################################################
import("//testing/libfuzzer/fuzzer_test.gni")

template("tint_fuzz_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker, "*", [ "configs" ])

    testonly = true

    if (!defined(invoker.deps)) {
      deps = []
    }

    if (!defined(invoker.public_deps)) {
      public_deps = []
    }
    public_deps += [ "${tint_src_dir}:generate_sources" ]

    if (defined(invoker.configs)) {
      configs += invoker.configs
    }

    configs += [ "${tint_src_dir}:tint_common_config" ]

    if (build_with_chromium) {
      configs -= [ "//build/config/compiler:chromium_code" ]
      configs += [ "//build/config/compiler:no_chromium_code" ]
    }

    if (!defined(invoker.public_configs)) {
      public_configs = []
    }

    public_configs += [ "${tint_src_dir}:tint_public_config" ]
  }
}

template("tint_fuzzer_test") {
  # fuzzer_test.gni doesn't handle targets that use 'output_name' correctly.
  # It will build an executable with the requested name, but the ClusterFuzz
  # data files (corpus, dictionary, options, owners, runtime_deps) will all
  # use the target name for their output file names, and these will not be
  # used by ClusterFuzz.
  # To work around this, if an 'output_name' is specified, pass the
  # 'output_name' to fuzzer_test() as the target name, then make a proxy
  # 'target_name' group that depends on the fuzzer target.
  if (defined(invoker.output_name)) {
    fuzzer_name = invoker.output_name
  } else {
    fuzzer_name = target_name
  }

  fuzzer_test(fuzzer_name) {
    forward_variables_from(invoker, "*", [ "output_name" ])
    if (use_centipede && !build_with_chromium) {
      exclude_main = true
      if (!defined(deps)) {
        deps = []
      }
      deps += [ "${tint_src_dir}:centipede_main" ]
    } else {
      exclude_main =
          (defined(invoker.exclude_main) && invoker.exclude_main) || false
    }

    # TODO(crbug.com/505034799): Determine best migration path for this.
    is_fuzztest_compatible = false

    if (target_name == "wgsl" || target_name == "wgsl_mesa") {
      dict = "${tint_src_dir}/cmd/fuzz/wgsl/dictionary.txt"
      libfuzzer_options = [
        # TODO(crbug.com/tint/2223): Remove this to fuzz unicode?
        "only_ascii=1",
        "max_len=10000",
      ]

      # There is a nightly job that generates the corpus for each of
      # the fuzzers and uploads them to cloud storage that
      # ClusterFuzz uses, so there is no need for this rule to
      # automatically generate the corpus. There are instructions in
      # docs/tint/fuzzers.md for how to generate the corpus locally
      # if needed.
    }
  }

  if (fuzzer_name != target_name) {
    group(target_name) {
      testonly = true
      data_deps = [ ":${fuzzer_name}" ]
    }
  }
}

template("tint_fuzztest_fuzzer") {
  # Match tint_fuzzer_test's handling of 'output_name': create the executable
  # using 'output_name' as the GN target name so Ninja can build it directly by
  # binary name, and expose a proxy group under 'target_name' so directory
  # labels also resolve.
  # Unlike tint_fuzzer_test, this uses executable() rather than fuzzer_test() so
  # it does not link libFuzzer's main() or //testing/libfuzzer:is_a_fuzz_target
  # (keeping prototype FuzzTest binaries off ClusterFuzz).
  if (defined(invoker.output_name)) {
    fuzzer_name = invoker.output_name
  } else {
    fuzzer_name = target_name
  }

  executable(fuzzer_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "output_name",
                           ])

    testonly = true

    if (defined(invoker.configs)) {
      configs += invoker.configs
    }

    configs += [
      "//testing/libfuzzer:fuzzer_test_config",
      "//testing/libfuzzer:no_clusterfuzz",
      "${tint_src_dir}:tint_unittests_config",
    ]

    if (build_with_chromium) {
      configs -= [ "//build/config/compiler:chromium_code" ]
      configs += [ "//build/config/compiler:no_chromium_code" ]
    }

    if (!defined(invoker.deps)) {
      deps = []
    }

    deps += [
      "${tint_src_dir}:fuzztest",
      "${tint_src_dir}:gmock_and_gtest",
    ]
  }

  if (fuzzer_name != target_name) {
    group(target_name) {
      testonly = true
      data_deps = [ ":${fuzzer_name}" ]
    }
  }
}
