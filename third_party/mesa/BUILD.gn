import("../../scripts/dawn_overrides_with_defaults.gni")
import("mesa_overrides_with_defaults.gni")

import("${mesa_meson_dir}/meson_overrides_with_defaults.gni")

_mesa_so = "${root_out_dir}/libvulkan_lvp.so"
_mesa_icd_json = "${root_out_dir}/lvp_icd.json"

if (is_linux) {
  copy("copy_zstd") {
    sources = [
      "${meson_zstd_dir}/lib/libzstd.so.1",
      "${meson_zstd_dir}/lib/libzstd.so.1.5.7",
    ]
    outputs = [ "${root_out_dir}/{{source_file_part}}" ]
  }
}

if (!mesa_use_gn_build) {
  import("${mesa_meson_dir}/meson_target.gni")

  meson_target("mesa_build") {
    source_dir = "src"
    options = mesa_options
    inputs = [ "${mesa_src_dir}/mesa_options.txt" ]
    outputs = [ "${target_gen_dir}/install" ]
  }

  action("copy_mesa_vulkan_icd") {
    script = "copy_mesa_driver.py"
    deps = [ ":mesa_build" ]
    args = [
      rebase_path("${target_gen_dir}/install", root_build_dir),
      rebase_path(root_out_dir, root_build_dir),
    ]
    outputs = [
      _mesa_icd_json,
      _mesa_so,
    ]
    data = [
      _mesa_icd_json,
      _mesa_so,
    ]
  }

  group("mesa_meson") {
    public_deps = [ ":copy_mesa_vulkan_icd" ]
    if (is_linux) {
      public_deps += [ ":copy_zstd" ]
      data = [
        "${root_out_dir}/libzstd.so.1",
        "${root_out_dir}/libzstd.so.1.5.7",
      ]
    }
  }

  group("mesa") {
    public_deps = [ ":mesa_meson" ]
    data_deps = [ ":mesa_meson" ]
  }
} else {
  import("//build/config/clang/clang.gni")
  import("//build/config/coverage/coverage.gni")
  import("mesa_sources.gni")

  assert(is_linux, "mesa_gn is currently only supported on Linux")

  _mesa_gen_dir = "${target_gen_dir}/mesa_gn"
  _vpython_spec = "${dawn_root}/vpython.toml"

  # Helper template to run a Mesa Python codegen script under vpython3.
  template("_mesa_action") {
    action(target_name) {
      script = "mesa_action.py"
      inputs = [
        _vpython_spec,
        invoker.python_script,
      ]
      if (defined(invoker.inputs)) {
        inputs += invoker.inputs
      }
      outputs = invoker.outputs
      if (defined(invoker.deps)) {
        deps = invoker.deps
      }
      if (defined(invoker.data)) {
        data = invoker.data
      }

      args = [
        "--vpython-spec",
        rebase_path(_vpython_spec, root_build_dir),
      ]
      if (defined(invoker.capture_stdout) && invoker.capture_stdout) {
        assert(outputs == [ outputs[0] ],
               "capture_stdout requires a single output file in ${target_name}")
        args += [
          "--capture-stdout",
          rebase_path(outputs[0], root_build_dir),
        ]
      }
      args += [
        "--",
        rebase_path(invoker.python_script, root_build_dir),
      ]
      if (defined(invoker.args)) {
        args += invoker.args
      }
    }
  }

  # ---------------------------------------------------------------------------
  # Codegen Actions (45 targets total)
  # ---------------------------------------------------------------------------

  _mesa_action("mesa_gn_git_sha1") {
    python_script = "src/bin/git_sha1_gen.py"
