      "${_mesa_gen_dir}/src/vulkan/runtime/vk_common_entrypoints.c",
    ]
    args = [
      "--xml",
      rebase_path(_vk_xml, root_build_dir),
      "--proto",
      "--weak",
      "--out-h",
      rebase_path(outputs[0], root_build_dir),
      "--out-c",
